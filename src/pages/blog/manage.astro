---
import { OneDriveManager } from "@/components/onedrive-blog";
import Layout from "@/layouts/blog.astro";
---

<Layout title="OneDrive 笔记分享" wide noindex>
  <section class="manage-intro">
    <div>
      <p class="eyebrow">ONEDRIVE / PUBLISH</p>
      <h1>选择值得分享的笔记</h1>
      <p class="muted">连接 OneDrive，选择文章，再把链接分享给别人。</p>
    </div>
  </section>
  <OneDriveManager client:only="react" />
</Layout>
