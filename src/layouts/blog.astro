---
import "@/styles/blog-theme.css";
import "@/styles/blog.css";

interface Props {
  description?: string;
  noindex?: boolean;
  title: string;
  wide?: boolean;
}
const {
  title,
  description = "设计观察、学习笔记与小工具。",
  wide = false,
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title} · Ten-W 博客</title>
    <meta name="description" content={description}>
    <meta name="robots" content={noindex ? "noindex,nofollow" : "index,follow"}>
    <link rel="icon" href="/favicon.svg">
  </head>
  <body class="blog-body">
    <a class="skip-link" href="#blog-main">跳到正文</a>
    <header class="blog-header">
      <a class="blog-brand" href="/blog/"
        ><span class="brand-mark" aria-hidden="true">N</span><span>Ten-W <span class="brand-section">/ 博客</span></span></a
      >
      <nav aria-label="网站导航">
        <a href="/">作品集 ↗</a>
        <a
          href="/blog/"
          aria-current={!Astro.url.pathname.startsWith("/blog/manage") ? "page" : undefined}
          >文章</a
        >
        <a
          href="/blog/manage/"
          aria-current={Astro.url.pathname.startsWith("/blog/manage") ? "page" : undefined}
          >笔记管理</a
        >
      </nav>
    </header>
    <main id="blog-main" class:list={["blog-main", { wide }]}><slot /></main>
    <footer class="blog-footer">
      <span>Ten-W · 记录与思考</span><span>只公开选择分享的内容</span>
    </footer>
  </body>
</html>
